# SisCoPerLocIA - Variables de entorno
# Copia este archivo como .env y llena los valores

# Notion API Token (Integration secret)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID (32 caracteres hex, sin guiones)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio API Key (empieza con AIza)
GOOGLE_AI_KEY=AIza...